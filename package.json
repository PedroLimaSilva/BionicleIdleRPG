{
  "name": "bionicle-idle-rpg",
  "private": true,
  "version": "0.8.2",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "lint": "eslint .",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:app": "playwright test --project='Desktop Chrome'",
    "test:e2e:models": "PLAYWRIGHT_MODELS_ONLY=1 playwright test --project=models",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:update-snapshots": "playwright test --update-snapshots=changed",
    "test:e2e:models:update-snapshots": "PLAYWRIGHT_MODELS_ONLY=1 playwright test --project=models --update-snapshots=changed",
    "test:e2e:docker": "bash scripts/run-playwright-docker.sh yarn test:e2e",
    "test:e2e:docker:models": "bash scripts/run-playwright-docker.sh yarn test:e2e:models",
    "test:e2e:docker:update": "bash scripts/run-playwright-docker.sh yarn test:e2e:update-snapshots",
    "test:e2e:docker:models:update": "bash scripts/run-playwright-docker.sh yarn test:e2e:models:update-snapshots",
    "test:e2e:docker:build": "docker compose -f docker-compose.playwright.yml build",
    "deploy": "yarn build && gh-pages -d dist",
    "preview": "vite preview",
    "compress": "bash scripts/compress-glb.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:unused-css": "tsx tools/check-unused-css.ts",
    "make-pwa-icons": "tsx scripts/make-pwa-icons.mts",
    "vendor-draco": "tsx scripts/vendor-draco-decoder.mts",
    "vendor-fonts": "tsx scripts/vendor-fonts.mts",
    "sum-glb-sizes": "tsx scripts/sum-glb-sizes.mts",
    "glb-size-report": "tsx scripts/glb-size-report.mts",
    "kit-node-usage-report": "tsx scripts/kit-node-usage-report.mts",
    "audit:prod": "tsx scripts/audit-prod.mts high",
    "audit:prod:critical": "tsx scripts/audit-prod.mts critical",
    "release:plan": "tsx scripts/release.mts plan",
    "release:notes": "tsx scripts/release.mts notes",
    "release:bump": "tsx scripts/release.mts bump",
    "release:refresh": "tsx scripts/release.mts refresh",
    "prepare": "husky && yarn vendor-draco && yarn vendor-fonts"
  },
  "dependencies": {
    "@posthog/react": "^1.10.5",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.5.0",
    "@react-three/postprocessing": "3.0.4",
    "@types/three": "0.160.0",
    "dexie": "^4.4.3",
    "lucide-react": "^0.487.0",
    "mermaid": "^11.15.0",
    "motion": "^12.34.3",
    "posthog-js": "^1.418.6",
    "r3f-perf": "^7.2.3",
    "react": "19",
    "react-dom": "19",
    "react-router-dom": "^7.18.2",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@gltf-transform/cli": "4.3.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^5.0.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "purgecss": "^8.0.0",
    "sass": "^1.83.4",
    "sharp": "0.35.4",
    "sharp-ico": "0.1.5",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-watch": "^0.3.1",
    "workbox-core": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "resolutions": {
    "@gltf-transform/cli": "4.3.0",
    "@react-three/drei": "10.7.8",
    "camera-controls": "3.1.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^4.1.1",
    "language-tags": "1.0.9",
    "lodash-es": "^4.18.0",
    "sharp": "0.35.4",
    "sharp-ico": "0.1.5"
  },
  "lint-staged": {
    "*.{cjs,css,html,js,json,jsx,md,mjs,scss,ts,tsx,yml,yaml}": "prettier --write"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
