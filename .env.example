# PostHog (optional — enables analytics consent prompt and telemetry)
# Local dev: copy to .env.local and fill in your project API key (gitignored).
# Production: set VITE_PUBLIC_POSTHOG_KEY as a GitHub Actions secret (see docs/TELEMETRY.md).
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
